{
  "name": "repack-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Arabic-first desktop manager for buying, repacking, credit sales, and collections.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5171 --strictPort",
    "desktop": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5171 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5171 electron .\"",
    "start:prod": "npm run build && electron .",
    "prestart:prod": "npm run rebuild:native:electron",
    "rebuild:native:node": "npm rebuild better-sqlite3",
    "rebuild:native:electron": "electron-rebuild -f -w better-sqlite3",
    "pretest": "npm run rebuild:native:node",
    "predesktop": "npm run rebuild:native:electron",
    "prepackage": "npm run rebuild:native:electron",
    "build": "tsc -b && vite build",
    "lint": "eslint src",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "docs:commands": "node scripts/docs-commands.cjs",
    "check:module-cycles": "node scripts/check-module-cycles.cjs",
    "test:migrations": "node --test tests/migrations.test.cjs",
    "test:operations": "node --test tests/operations.test.cjs",
    "test": "node --test tests/*.test.cjs",
    "preview": "vite preview",
    "package": "npm run build && electron-builder",
    "dist:windows": "npm run build && npm run rebuild:native:windows && electron-builder --win --x64"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.repackmanager.app",
    "productName": "مدير التعبئة",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/app-icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
